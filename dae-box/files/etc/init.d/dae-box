#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/dae-box
CONF=/etc/dae-box/config.yaml

start_service() {
	config_load dae-box
	local enabled config_file

	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get config_file config config_file "$CONF"

	mkdir -p /etc/dae-box

	procd_open_instance
	procd_set_param command "$PROG" -c "$config_file"
	procd_set_param respawn
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 卸载挂载的 tc / eBPF 探针由守护进程优雅退出处理
	return 0
}

service_triggers() {
	procd_add_reload_trigger "dae-box"
}
