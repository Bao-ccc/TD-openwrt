config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd98:da61:ca29::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '10.0.0.1'
	option netmask '255.255.255.0'
	option ip6addr '240e:390:6eec:24b0::1/64'
	option ip6assign '64'

config interface 'wan'
	option device 'eth1'
	option proto 'pppoe'

config interface 'wan_6'
	option device '@wan'
	option proto 'dhcpv6'
	option reqprefix '60'

config interface 'wan6'
	option device 'eth1'
	option proto 'dhcpv6'
